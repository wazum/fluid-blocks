config {
  debug = 1
}

[traverse(page, "uid") == 5]
  config.no_cache = 1
[END]

lib.contentElement = FLUIDTEMPLATE
lib.contentElement {
  templateName.field = CType
  templateRootPaths.10 = EXT:fluid_blocks_e2e/Resources/Private/Templates/Content/
  layoutRootPaths.10 = EXT:fluid_blocks_e2e/Resources/Private/Layouts/
  partialRootPaths.10 = EXT:fluid_blocks_e2e/Resources/Private/Partials/
}

lib.element = CASE
lib.element {
  key.field = CType
  default < lib.contentElement
  Uncached = COA_INT
  Uncached.10 < lib.contentElement
  NotFound = USER
  NotFound.userFunc = Wazum\FluidBlocksE2e\PageNotFound->render
}

page = PAGE
page {
  10 = FLUIDTEMPLATE
  10 {
    templateName = Default
    templateRootPaths.10 = EXT:fluid_blocks_e2e/Resources/Private/Templates/Page/
    layoutRootPaths.10 = EXT:fluid_blocks_e2e/Resources/Private/Layouts/
    partialRootPaths.10 = EXT:fluid_blocks_e2e/Resources/Private/Partials/
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
    dataProcessing.10 {
      table = tt_content
      orderBy = sorting
      as = elements
    }
  }

  headerData.10 = FLUIDTEMPLATE
  headerData.10.file = EXT:fluid_blocks_e2e/Resources/Private/Templates/Page/Head.html
}
